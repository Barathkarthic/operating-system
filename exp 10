#include <stdio.h>

int main() {
    int n, f, req[20], buf[10], fault=0, front=0, hit;

    printf("Enter buffer size: ");
    scanf("%d", &f);

    for(int i=0; i<f; i++) buf[i] = -1;

    printf("Enter number of telemetry requests: ");
    scanf("%d", &n);

    printf("Enter sequence (sensor IDs): ");
    for(int i=0; i<n; i++) scanf("%d", &req[i]);

    for(int i=0; i<n; i++) {
        hit = 0;
        for(int j=0; j<f; j++) {
            if(buf[j] == req[i]) hit = 1;
        }
        if(!hit) {
            buf[front] = req[i];
            front = (front + 1) % f; // FIFO circular queue
            fault++;
        }
    }

    printf("Total Telemetry Misses (Faults): %d\n", fault);
    return 0;
}
