
#include <stdio.h>

int main() {
    int n, bt[10], pr[10], id[10], wt = 0, tat = 0;

    printf("Enter number of flights: ");
    scanf("%d", &n);

    printf("Enter landing time & priority (1=Emergency) for each:\n");
    for(int i = 0; i < n; i++) {
        scanf("%d%d", &bt[i], &pr[i]);
        id[i] = i + 1;
    }

    // Sort by Highest Priority (Lowest Number)
    for(int i = 0; i < n - 1; i++) {
        for(int j = 0; j < n - i - 1; j++) {
            if(pr[j] > pr[j+1]) {
                int t = pr[j]; pr[j] = pr[j+1]; pr[j+1] = t;
                t = bt[j]; bt[j] = bt[j+1]; bt[j+1] = t;
                t = id[j]; id[j] = id[j+1]; id[j+1] = t;
            }
        }
    }

    printf("\nFlight\tTime\tPri\tWait\tTAT\n");
    for(int i = 0; i < n; i++) {
        tat = wt + bt[i];
        printf("%d\t%d\t%d\t%d\t%d\n", id[i], bt[i], pr[i], wt, tat);
        wt += bt[i];
    }

    return 0;
}
