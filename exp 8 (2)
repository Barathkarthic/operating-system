#include <stdio.h>

int main() {
    int p[3] = {1, 2, 3}, bt[3] = {6, 3, 8}, wt[3] = {0}, tat[3], i, j, temp;
    float tot_wt = 0, tot_tat = 0;

    for (i = 0; i < 3 - 1; i++) {
        for (j = i + 1; j < 3; j++) {
            if (bt[i] > bt[j]) {
                temp = bt[i];
                bt[i] = bt[j];
                bt[j] = temp;

                temp = p[i];
                p[i] = p[j];
                p[j] = temp;
            }
        }
    }

    for (i = 1; i < 3; i++) {
        wt[i] = wt[i - 1] + bt[i - 1];
    }

    for (i = 0; i < 3; i++) {
        tat[i] = wt[i] + bt[i];
        tot_wt += wt[i];
        tot_tat += tat[i];
    }

    for (i = 0; i < 3; i++) {
        printf("P%d | BT: %d | WT: %d | TAT: %d\n", p[i], bt[i], wt[i], tat[i]);
    }

    printf("Avg WT: %.2f | Avg TAT: %.2f\n", tot_wt / 3, tot_tat / 3);

    return 0;
}
